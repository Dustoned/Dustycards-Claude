(dustycards_proxy) {
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

(dustycards_routes) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(), microphone=(), payment=(), usb=()"
		# The application generates a fresh nonce for every HTML response. Do not
		# replace that dynamic CSP here with a static policy that permits inline
		# scripts; Caddy keeps the transport-level headers and forwards the nonce
		# policy produced by Next.js unchanged.
	}

	# Bound bodies before Next.js allocates/parses them. The scanner is the only
	# endpoint that intentionally accepts a multi-megabyte upload.
	@scanner_upload {
		method POST
		path /api/cards/scan
	}
	request_body @scanner_upload {
		max_size 12MB
	}
	@normal_write {
		method POST PUT PATCH DELETE
		not path /api/cards/scan
	}
	request_body @normal_write {
		max_size 1MB
	}

	# DustyCards has no PHP surface. Reject common exploit scans at the edge so
	# they never occupy the single Next.js web process.
	@blocked_php path_regexp blocked_php (?i)\.php(?:/|$)
	handle @blocked_php {
		respond 404
	}

	# Static browser runtime files must remain available even while a database
	# request is busy. The shared directory contains the current build plus
	# recently deployed hashed assets, so an already-open tab does not lose a
	# lazy JavaScript chunk or font at the exact moment a new release goes live.
	handle_path /_next/static/* {
		root * /opt/dustycards/cache/next-static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /dustycards-sw.js {
		root * /opt/dustycards/app/public
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# App icons are source-controlled public assets. Serve them at the edge so
	# browser chrome and installed mobile shortcuts never wait behind a dynamic
	# page render or an occupied Next.js process.
	handle /icons/* {
		root * /opt/dustycards/app/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		import dustycards_proxy
	}
}

(dustycards_access_log) {
	log {
		output file /var/log/caddy/dustycards-access.log {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}

dustycards.myftp.org, dustycards.93-190-187-221.sslip.io {
	import dustycards_access_log
	import dustycards_routes
}

:80 {
	import dustycards_access_log
	redir https://dustycards.myftp.org{uri} permanent
}
