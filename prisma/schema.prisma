generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Episode {
  id            String   @id
  game          String   @default("pokemon")
  name          String
  code          String?
  release_date  String?
  card_count    Int?
  printed_card_count Int?
  logo_url      String?
  symbol_url    String?
  series        String?
  source_status String?
  source_checked_at DateTime?
  source_actual_card_count Int?
  is_user_submitted Boolean @default(false)
  synced_at     DateTime?
  created_at    DateTime @default(now())

  cards          Card[]
  binders        CollectionBinder[]
  sealedProducts SealedProduct[]
  cardSubmissions CardSubmission[]

  @@index([source_status, source_checked_at])
  @@index([game, release_date])
  @@index([game, code])
  @@index([printed_card_count])
  @@index([is_user_submitted])
}

model AppSetting {
  key        String   @id
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  role          String   @default("user")
  disabled      Boolean  @default(false)
  settings_json String?
  email_verified_at DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  sessions        Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  binders         CollectionBinder[]
  collectionCards CollectionCard[]
  wants           CollectionWant[]
  sealedItems     CollectionSealed[]
  ebayListingCardOverrides EbayListingCardOverride[]
  cardSubmissions CardSubmission[]

  @@index([role])
  @@index([disabled])
  @@index([email_verified_at])
}

model Session {
  id         String   @id @default(cuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([used_at])
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model SetPullRateProfile {
  id                    String   @id @default(cuid())
  source                String   @default("collectrics")
  set_code              String
  set_name              String?
  generated_at          String?
  release_date          String?
  promo_flag            String?
  rarity_buckets        Int?
  cards_counted         Int?
  psa_pop_10_base       Int?
  psa_pop_total_base    Int?
  psa_avg_gem_pct       Float?
  imported_at           DateTime @default(now())
  updated_at            DateTime @updatedAt

  rarities              SetPullRateRarity[]

  @@unique([source, set_code])
  @@index([set_code])
  @@index([imported_at])
}

model SetPullRateRarity {
  id                         String   @id @default(cuid())
  profile_id                 String
  source                     String
  set_code                   String
  normalized_rarity          String
  rarity_code                String?
  rarity_name                String
  card_count                 Int?
  pull_rate                  Float?
  pull_rate_odds             String?
  pull_rate_denominator      Float?
  specific_pull_denominator  Float?
  psa_pop_10_base            Int?
  psa_pop_total_base         Int?
  psa_avg_gem_pct            Float?
  imported_at                DateTime @default(now())

  profile                    SetPullRateProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, normalized_rarity])
  @@index([source, set_code])
  @@index([source, set_code, normalized_rarity])
}

model SealedProduct {
  id              String   @id
  game            String   @default("pokemon")
  episode_id      String
  name            String
  image_url       String?
  tcggo_url       String?
  cardmarket_url  String?
  cardmarket_id   String?
  tcgplayer_id    String?
  cm_lowest       Float?
  cm_lowest_eu    Float?
  cm_lowest_de    Float?
  cm_lowest_fr    Float?
  cm_lowest_es    Float?
  cm_lowest_it    Float?
  cm_avg_7d       Float?
  cm_avg_30d      Float?
  native_history_synced_at DateTime?
  native_history_status     String?
  native_history_checked_at DateTime?
  synced_at       DateTime @default(now())

  episode         Episode  @relation(fields: [episode_id], references: [id])
  collectionItems CollectionSealed[]

  @@index([episode_id])
  @@index([game, episode_id])
  @@index([name])
  @@index([native_history_synced_at])
  @@index([native_history_status, native_history_checked_at])
}

model SealedPriceSnapshot {
  id              String   @id @default(cuid())
  product_id      String
  episode_id      String
  fetched_at      DateTime @default(now())
  cm_lowest       Float?
  cm_lowest_eu    Float?
  cm_lowest_de    Float?
  cm_lowest_fr    Float?
  cm_lowest_es    Float?
  cm_lowest_it    Float?
  cm_avg_7d       Float?
  cm_avg_30d      Float?

  @@index([product_id])
  @@index([product_id, fetched_at])
  @@index([episode_id, fetched_at])
}

model Card {
  id              String   @id
  game            String   @default("pokemon")
  episode_id      String
  name            String
  card_number     String?
  printed_card_number String?
  rarity          String?
  hp              Int?
  supertype       String?
  subtypes        String?
  artist          String?
  image_url       String?
  tcggo_url       String?
  cardmarket_url  String?
  tcgid           String?
  cardmarket_id   String?
  tcgplayer_id    String?
  tcggo_score      Float?
  tcggo_score_tier String?
  tcggo_score_momentum Float?
  tcggo_score_stability Float?
  tcggo_score_liquidity Float?
  tcggo_score_demand Float?
  tcggo_score_market_depth Float?
  tcggo_score_grade_premium Float?
  tcggo_score_rsi Float?
  tcggo_score_ath Float?
  tcggo_score_atl Float?
  tcggo_score_synced_at DateTime?
  tcggo_score_updated_at DateTime?
  price_source_status     String?
  price_source_checked_at DateTime?
  native_history_synced_at DateTime?
  native_history_status     String?
  native_history_checked_at DateTime?
  ebay_sold_graded_synced_at DateTime?
  ebay_sold_graded_status     String?
  ebay_sold_graded_checked_at DateTime?
  is_user_submitted Boolean @default(false)
  submitted_by_user_id String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  episode         Episode  @relation(fields: [episode_id], references: [id])
  collectionItems CollectionCard[]
  wants           CollectionWant[]
  gradedPrices    CardGradedPrice[]
  gradedPriceSnapshots CardGradedPriceSnapshot[]
  ebaySoldGradedPrices CardEbaySoldGradedPrice[]
  ebaySoldGradedPriceSnapshots CardEbaySoldGradedPriceSnapshot[]
  ebayListingOverrides EbayListingCardOverride[]
  prices          Price[]
  cardSubmissions CardSubmission[] @relation("SubmissionCreatedCard")
  officialCardSubmissions CardSubmission[] @relation("SubmissionOfficialCard")

  @@index([episode_id])
  @@index([game, episode_id])
  @@index([episode_id, card_number])
  @@index([printed_card_number])
  @@index([price_source_status, price_source_checked_at])
  @@index([native_history_synced_at])
  @@index([native_history_status, native_history_checked_at])
  @@index([ebay_sold_graded_synced_at])
  @@index([ebay_sold_graded_status, ebay_sold_graded_checked_at])
  @@index([tcggo_url, price_source_status, price_source_checked_at])
  @@index([is_user_submitted])
  @@index([submitted_by_user_id])
}

model CardSubmission {
  id                    String   @id @default(cuid())
  user_id               String?
  status                String   @default("preview")
  game                  String   @default("pokemon")
  input_name            String
  input_set_name        String
  input_card_number     String?
  input_cardmarket_url  String?
  input_condition       String?  @default("Near Mint")
  normalized_key        String
  duplicate_card_id     String?
  card_id               String?
  episode_id            String?
  official_card_id      String?
  detected_name         String?
  detected_set_name     String?
  detected_card_number  String?
  detected_language     String?
  detected_condition    String?
  cardmarket_url        String?
  cardmarket_id         String?
  image_url             String?
  nm_price_eur          Float?
  confidence            Float?
  warnings_json         String?
  firecrawl_search_json String?
  firecrawl_scrape_json String?
  search_count          Int      @default(0)
  scrape_count          Int      @default(0)
  credits_used          Int      @default(0)
  last_scraped_at       DateTime?
  migrated_at           DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user                  User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  card                  Card?    @relation("SubmissionCreatedCard", fields: [card_id], references: [id], onDelete: SetNull)
  episode               Episode? @relation(fields: [episode_id], references: [id], onDelete: SetNull)
  officialCard          Card?    @relation("SubmissionOfficialCard", fields: [official_card_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([status, created_at])
  @@index([normalized_key, status])
  @@index([card_id])
  @@index([episode_id])
  @@index([official_card_id])
  @@index([cardmarket_id])
}

model CardGradedPrice {
  id         String   @id @default(cuid())
  card_id    String
  label      String
  price      Float
  fetched_at DateTime @default(now())

  card       Card     @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@unique([card_id, label])
}

model CardGradedPriceSnapshot {
  id         String   @id @default(cuid())
  card_id    String
  label      String
  price      Float
  fetched_at DateTime @default(now())

  card       Card     @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([card_id, label, fetched_at])
  @@index([fetched_at])
}

model CardEbaySoldGradedPrice {
  id           String   @id @default(cuid())
  card_id      String
  source       String   @default("ebay_sold")
  label        String
  company      String
  grade        String
  median_price Float
  currency     String   @default("USD")
  sample_size  Int?
  fetched_at   DateTime @default(now())

  card         Card     @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([card_id, source])
  @@index([company, grade])
  @@unique([card_id, source, label])
}

model CardEbaySoldGradedPriceSnapshot {
  id           String   @id @default(cuid())
  card_id      String
  source       String   @default("ebay_sold")
  label        String
  company      String
  grade        String
  median_price Float
  currency     String   @default("USD")
  sample_size  Int?
  fetched_at   DateTime @default(now())

  card         Card     @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([card_id, source, label, fetched_at])
  @@index([fetched_at])
}

model EbayListingCardOverride {
  id              String   @id @default(cuid())
  user_id         String
  marketplace_id  String
  item_id         String
  card_id         String?
  status          String
  title_snapshot  String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card            Card?    @relation(fields: [card_id], references: [id], onDelete: SetNull)

  @@unique([user_id, marketplace_id, item_id])
  @@index([card_id])
  @@index([user_id, status])
}

model CollectionBinder {
  id                  String   @id @default(cuid())
  user_id             String?
  name                String
  type                String
  episode_id          String?
  accent_color        String?
  icon_name           String?
  notes               String?
  base_purchase_price Float?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user                User?            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  episode             Episode?         @relation(fields: [episode_id], references: [id])
  cards               CollectionCard[]

  @@index([user_id])
  @@index([type])
  @@index([episode_id])
  @@index([created_at])
}

model CollectionCard {
  id              String   @id @default(cuid())
  user_id         String?
  card_id         String
  binder_id       String?
  purchase_price  Float?
  condition       String?
  language        String?
  notes           String?
  grading_company String?
  grading_grade   String?
  grading_subgrades_json String?
  for_sale        Boolean  @default(false)
  sale_price      Float?
  sold_at         DateTime?
  added_at        DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User?             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card            Card              @relation(fields: [card_id], references: [id])
  binder          CollectionBinder? @relation(fields: [binder_id], references: [id], onDelete: SetNull)
  tags            CollectionCardTag[]

  @@index([user_id])
  @@index([card_id])
  @@index([card_id, added_at])
  @@index([binder_id])
  @@index([binder_id, added_at])
  @@index([user_id, for_sale])
  @@index([user_id, for_sale, sold_at])
  @@index([sold_at])
  @@index([added_at])
}

model CollectionCardTag {
  id                 String         @id @default(cuid())
  collection_card_id String
  label              String

  collection_card    CollectionCard @relation(fields: [collection_card_id], references: [id], onDelete: Cascade)

  @@index([collection_card_id])
  @@index([label])
}

model CollectionWant {
  id                String    @id @default(cuid())
  user_id           String
  card_id           String
  notes             String?
  source            String    @default("manual")
  source_episode_id String?
  dismissed_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card              Card      @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([user_id, card_id])
  @@index([user_id])
  @@index([card_id])
  @@index([source])
  @@index([source_episode_id])
  @@index([dismissed_at])
  @@index([created_at])
}

model CollectionSealed {
  id                      String   @id @default(cuid())
  user_id                 String?
  product_id              String
  quantity                Int      @default(1)
  purchase_price_per_item Float?
  notes                   String?
  added_at                DateTime @default(now())
  updated_at              DateTime @updatedAt

  user                    User?                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product                 SealedProduct         @relation(fields: [product_id], references: [id])
  tags                    CollectionSealedTag[]

  @@index([user_id])
  @@index([product_id])
  @@index([product_id, added_at])
  @@index([added_at])
}

model CollectionSealedTag {
  id                   String           @id @default(cuid())
  collection_sealed_id String
  label                String

  collection_sealed    CollectionSealed @relation(fields: [collection_sealed_id], references: [id], onDelete: Cascade)

  @@index([collection_sealed_id])
  @@index([label])
}

model Price {
  id                    String   @id @default(cuid())
  card_id               String
  fetched_at            DateTime @default(now())

  // CardMarket prices per language
  cm_en_lowest_nm       Float?
  cm_de_lowest_nm       Float?
  cm_fr_lowest_nm       Float?
  cm_es_lowest_nm       Float?
  cm_it_lowest_nm       Float?
  cm_jp_lowest_nm       Float?
  cm_en_avg_30d         Float?
  cm_en_avg_7d          Float?

  // TCGPlayer prices
  tcp_market            Float?
  tcp_mid               Float?
  tcp_low               Float?

  card                  Card     @relation(fields: [card_id], references: [id])

  @@index([card_id])
  @@index([card_id, fetched_at])
  @@index([card_id, fetched_at, id])
  @@index([fetched_at])
}

model SyncLog {
  id          String   @id @default(cuid())
  type        String
  status      String
  message     String?
  details_json String?
  started_at  DateTime @default(now())
  finished_at DateTime?
  cancel_requested_at DateTime?

  @@index([status, started_at])
  @@index([type, status, started_at])
  @@index([type, status, finished_at])
  @@index([cancel_requested_at])
}

model SyncJob {
  id           String   @id @default(cuid())
  type         String   @unique
  status       String
  details_json String?
  started_at   DateTime?
  finished_at  DateTime?
  heartbeat_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([status, updated_at])
  @@index([type, status])
}

model ApiQuotaSnapshot {
  source             String   @id
  requests_limit     Int?
  requests_remaining Int?
  requests_used      Int?
  quota_resets_at    DateTime?
  observed_at        DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([quota_resets_at])
}
