generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Episode {
  id                       String    @id
  game                     String    @default("pokemon")
  name                     String
  code                     String?
  release_date             String?
  card_count               Int?
  printed_card_count       Int?
  logo_url                 String?
  symbol_url               String?
  series                   String?
  source_status            String?
  source_checked_at        DateTime?
  source_actual_card_count Int?
  is_user_submitted        Boolean   @default(false)
  synced_at                DateTime?
  created_at               DateTime  @default(now())

  cards                 Card[]
  binders               CollectionBinder[]
  sealedProducts        SealedProduct[]
  sealedProductContents SealedProductContentSet[]
  lifecycleObservations SetLifecycleObservation[]
  cardSubmissions       CardSubmission[]

  @@index([source_status, source_checked_at])
  @@index([game, release_date])
  @@index([game, code])
  @@index([printed_card_count])
  @@index([is_user_submitted])
}

model AppSetting {
  key        String   @id
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password_hash     String
  role              String    @default("user")
  disabled          Boolean   @default(false)
  settings_json     String?
  email_verified_at DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  sessions                 Session[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  binders                  CollectionBinder[]
  collectionCards          CollectionCard[]
  wants                    CollectionWant[]
  sealedItems              CollectionSealed[]
  ebayListingCardOverrides EbayListingCardOverride[]
  ebayWatchedListings      EbayWatchedListing[]
  cardPriceAlerts          CardPriceAlert[]
  collectionPriceAlerts    CollectionPriceAlert[]
  binderShareLinks         BinderShareLink[]
  cardSubmissions          CardSubmission[]
  feedback                 Feedback[]
  socialRequestsSent       SocialConnection[]        @relation("SocialConnectionRequester")
  socialRequestsReceived   SocialConnection[]        @relation("SocialConnectionAddressee")
  socialConnectionsAsA     SocialConnection[]        @relation("SocialConnectionUserA")
  socialConnectionsAsB     SocialConnection[]        @relation("SocialConnectionUserB")

  @@index([role])
  @@index([disabled])
  @@index([email_verified_at])
}

model SocialConnection {
  id                       String    @id @default(cuid())
  requester_id             String
  addressee_id             String
  user_a_id                String
  user_b_id                String
  status                   String    @default("pending")
  accepted_at              DateTime?
  full_access_status       String    @default("none")
  full_access_requester_id String?
  full_access_requested_at DateTime?
  full_access_accepted_at  DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  requester User @relation("SocialConnectionRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee User @relation("SocialConnectionAddressee", fields: [addressee_id], references: [id], onDelete: Cascade)
  userA     User @relation("SocialConnectionUserA", fields: [user_a_id], references: [id], onDelete: Cascade)
  userB     User @relation("SocialConnectionUserB", fields: [user_b_id], references: [id], onDelete: Cascade)

  @@unique([user_a_id, user_b_id])
  @@index([requester_id, status])
  @@index([addressee_id, status])
  @@index([user_a_id, status])
  @@index([user_b_id, status])
  @@index([status, updated_at])
  @@index([full_access_status, updated_at])
  @@index([full_access_requester_id])
}

model Session {
  id         String   @id @default(cuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([used_at])
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model SetPullRateProfile {
  id                     String   @id @default(cuid())
  source                 String   @default("collectrics")
  set_code               String
  set_name               String?
  source_url             String?
  source_note            String?
  generated_at           String?
  release_date           String?
  prices_updated_at      String?
  promo_flag             String?
  rarity_buckets         Int?
  cards_counted          Int?
  booster_pack_ev_usd    Float?
  booster_box_ev_usd     Float?
  packs_per_booster_box  Float?
  cards_per_booster_pack Float?
  psa_pop_10_base        Int?
  psa_pop_total_base     Int?
  psa_avg_gem_pct        Float?
  imported_at            DateTime @default(now())
  updated_at             DateTime @updatedAt

  rarities SetPullRateRarity[]

  @@unique([source, set_code])
  @@index([set_code])
  @@index([imported_at])
}

model SetPullRateRarity {
  id                        String   @id @default(cuid())
  profile_id                String
  source                    String
  set_code                  String
  normalized_rarity         String
  rarity_code               String?
  rarity_name               String
  card_count                Int?
  per_booster_box           Float?
  pull_rate                 Float?
  pull_rate_odds            String?
  pull_rate_denominator     Float?
  specific_pull_denominator Float?
  ev_total                  Int?
  ev_priced                 Int?
  avg_value_usd             Float?
  ev_per_pack_usd           Float?
  psa_pop_10_base           Int?
  psa_pop_total_base        Int?
  psa_avg_gem_pct           Float?
  imported_at               DateTime @default(now())

  profile SetPullRateProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, normalized_rarity])
  @@index([source, set_code])
  @@index([source, set_code, normalized_rarity])
}

model SealedProduct {
  id                        String    @id
  game                      String    @default("pokemon")
  episode_id                String
  name                      String
  image_url                 String?
  tcggo_url                 String?
  cardmarket_url            String?
  cardmarket_id             String?
  tcgplayer_id              String?
  cm_lowest                 Float?
  cm_lowest_eu              Float?
  cm_lowest_de              Float?
  cm_lowest_fr              Float?
  cm_lowest_es              Float?
  cm_lowest_it              Float?
  cm_avg_7d                 Float?
  cm_avg_30d                Float?
  release_date              DateTime?
  release_date_source       String?
  release_date_source_url   String?
  release_date_confidence   Float?
  release_date_checked_at   DateTime?
  native_history_synced_at  DateTime?
  native_history_status     String?
  native_history_checked_at DateTime?
  synced_at                 DateTime  @default(now())

  episode                   Episode                   @relation(fields: [episode_id], references: [id])
  collectionItems           CollectionSealed[]
  originatedCollectionCards CollectionCard[]          @relation("CollectionCardOriginSealedProduct")
  contentSets               SealedProductContentSet[]
  includedCards             CardSealedProduct[]

  @@index([episode_id])
  @@index([game, episode_id])
  @@index([name])
  @@index([release_date])
  @@index([native_history_synced_at])
  @@index([native_history_status, native_history_checked_at])
}

model SealedProductContentSet {
  product_id  String
  episode_id  String
  source_name String?
  source_url  String?
  confidence  Float?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  product SealedProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  episode Episode       @relation(fields: [episode_id], references: [id], onDelete: Cascade)

  @@id([product_id, episode_id])
  @@index([episode_id])
  @@index([product_id])
}

model CardSealedProduct {
  card_id       String
  product_id    String
  relation_type String   @default("included_promo")
  source_name   String?
  source_url    String?
  confidence    Float?
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  card    Card          @relation(fields: [card_id], references: [id], onDelete: Cascade)
  product SealedProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([card_id, product_id])
  @@index([card_id])
  @@index([product_id])
  @@index([relation_type])
}

model SealedReleaseWatch {
  id                 String   @id
  game               String   @default("pokemon")
  name               String
  release_date       DateTime
  image_url          String?
  source_name        String
  source_url         String
  confidence         Float?
  matched_product_id String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([source_url, name])
  @@index([game, release_date])
  @@index([matched_product_id])
}

model SealedPriceSnapshot {
  id           String   @id @default(cuid())
  product_id   String
  episode_id   String
  fetched_at   DateTime @default(now())
  cm_lowest    Float?
  cm_lowest_eu Float?
  cm_lowest_de Float?
  cm_lowest_fr Float?
  cm_lowest_es Float?
  cm_lowest_it Float?
  cm_avg_7d    Float?
  cm_avg_30d   Float?

  @@index([product_id])
  @@index([product_id, fetched_at])
  @@index([episode_id, fetched_at])
}

// Weekly, set-level supply observations. These rows are deliberately derived
// from data that is already stored locally; the scheduler never spends an API
// or crawl credit to create them. A status is only "confirmed" when the
// evidence contains an explicit authoritative out-of-print statement.
model SetLifecycleObservation {
  id                        String    @id @default(cuid())
  episode_id                String
  status                    String
  oop_probability           Float
  confidence                Float
  release_age_days          Int?
  product_count             Int       @default(0)
  priced_product_count      Int       @default(0)
  pack_product_count        Int       @default(0)
  latest_product_release_at DateTime?
  latest_supply_observed_at DateTime?
  trend_30d_pct             Float?
  trend_90d_pct             Float?
  explicit_oop              Boolean   @default(false)
  active_reprint            Boolean   @default(false)
  evidence_json             String?
  model_version             String
  observation_bucket        DateTime
  observed_at               DateTime  @default(now())
  created_at                DateTime  @default(now())

  episode Episode @relation(fields: [episode_id], references: [id], onDelete: Cascade)

  @@unique([episode_id, observation_bucket, model_version])
  @@index([episode_id, observed_at])
  @@index([status, confidence, observed_at])
  @@index([observation_bucket, model_version])
}

model Card {
  id                          String    @id
  game                        String    @default("pokemon")
  episode_id                  String
  name                        String
  card_number                 String?
  printed_card_number         String?
  version                     String?
  rarity                      String?
  hp                          Int?
  supertype                   String?
  subtypes                    String?
  artist                      String?
  image_url                   String?
  tcggo_url                   String?
  cardmarket_url              String?
  tcgid                       String?
  cardmarket_id               String?
  tcgplayer_id                String?
  tcggo_score                 Float?
  tcggo_score_tier            String?
  tcggo_score_momentum        Float?
  tcggo_score_stability       Float?
  tcggo_score_liquidity       Float?
  tcggo_score_demand          Float?
  tcggo_score_market_depth    Float?
  tcggo_score_grade_premium   Float?
  tcggo_score_rsi             Float?
  tcggo_score_ath             Float?
  tcggo_score_atl             Float?
  tcggo_score_synced_at       DateTime?
  tcggo_score_updated_at      DateTime?
  // Persisted DustyCards market score (buildCardMarketStats), refreshed by a
  // background job so search can rank on real market interest.
  market_score                Float?
  market_score_momentum       Float?
  market_score_liquidity      Float?
  market_score_demand         Float?
  market_score_updated_at     DateTime?
  price_source_status         String?
  price_source_checked_at     DateTime?
  native_history_synced_at    DateTime?
  native_history_status       String?
  native_history_checked_at   DateTime?
  ebay_sold_graded_synced_at  DateTime?
  ebay_sold_graded_status     String?
  ebay_sold_graded_checked_at DateTime?
  is_user_submitted           Boolean   @default(false)
  submitted_by_user_id        String?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  episode                      Episode                           @relation(fields: [episode_id], references: [id])
  collectionItems              CollectionCard[]
  wants                        CollectionWant[]
  gradedPrices                 CardGradedPrice[]
  gradedPriceSnapshots         CardGradedPriceSnapshot[]
  ebaySoldGradedPrices         CardEbaySoldGradedPrice[]
  ebaySoldGradedPriceSnapshots CardEbaySoldGradedPriceSnapshot[]
  ebayDemandListings           CardEbayDemandListing[]
  ebayDemandSnapshots          CardEbayDemandSnapshot[]
  ebayListingOverrides         EbayListingCardOverride[]
  ebayWatchedListings          EbayWatchedListing[]
  priceAlerts                  CardPriceAlert[]
  newReleaseChasePriceWatch    NewReleaseChasePriceWatch?
  prices                       Price[]
  sealedProducts               CardSealedProduct[]
  cardSubmissions              CardSubmission[]                  @relation("SubmissionCreatedCard")
  officialCardSubmissions      CardSubmission[]                  @relation("SubmissionOfficialCard")

  @@index([episode_id])
  @@index([game, episode_id])
  @@index([episode_id, card_number])
  @@index([artist])
  @@index([game, rarity])
  @@index([printed_card_number])
  @@index([price_source_status, price_source_checked_at])
  @@index([native_history_synced_at])
  @@index([native_history_status, native_history_checked_at])
  @@index([ebay_sold_graded_synced_at])
  @@index([ebay_sold_graded_status, ebay_sold_graded_checked_at])
  @@index([tcggo_url, price_source_status, price_source_checked_at])
  @@index([market_score_updated_at])
  @@index([is_user_submitted])
  @@index([submitted_by_user_id])
}

model CardSubmission {
  id                    String    @id @default(cuid())
  user_id               String?
  status                String    @default("preview")
  game                  String    @default("pokemon")
  input_name            String
  input_set_name        String
  input_card_number     String?
  input_cardmarket_url  String?
  input_condition       String?   @default("Near Mint")
  normalized_key        String
  duplicate_card_id     String?
  card_id               String?
  episode_id            String?
  official_card_id      String?
  detected_name         String?
  detected_set_name     String?
  detected_card_number  String?
  detected_language     String?
  detected_condition    String?
  cardmarket_url        String?
  cardmarket_id         String?
  image_url             String?
  nm_price_eur          Float?
  confidence            Float?
  warnings_json         String?
  firecrawl_search_json String?
  firecrawl_scrape_json String?
  search_count          Int       @default(0)
  scrape_count          Int       @default(0)
  credits_used          Int       @default(0)
  last_scraped_at       DateTime?
  migrated_at           DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  user         User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  card         Card?    @relation("SubmissionCreatedCard", fields: [card_id], references: [id], onDelete: SetNull)
  episode      Episode? @relation(fields: [episode_id], references: [id], onDelete: SetNull)
  officialCard Card?    @relation("SubmissionOfficialCard", fields: [official_card_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([status, created_at])
  @@index([normalized_key, status])
  @@index([card_id])
  @@index([episode_id])
  @@index([official_card_id])
  @@index([cardmarket_id])
}

model Feedback {
  id         String   @id @default(cuid())
  user_id    String
  category   String   @default("general")
  message    String
  page_url   String?
  status     String   @default("new")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([user_id, created_at])
}

model CardGradedPrice {
  id         String   @id @default(cuid())
  card_id    String
  label      String
  price      Float
  fetched_at DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([card_id, label])
  @@index([card_id])
}

model CardGradedPriceSnapshot {
  id         String   @id @default(cuid())
  card_id    String
  label      String
  price      Float
  fetched_at DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([card_id, label, fetched_at])
  @@index([fetched_at])
}

model CardEbaySoldGradedPrice {
  id           String   @id @default(cuid())
  card_id      String
  source       String   @default("ebay_sold")
  label        String
  company      String
  grade        String
  median_price Float
  currency     String   @default("USD")
  sample_size  Int?
  fetched_at   DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([card_id, source, label])
  @@index([card_id])
  @@index([card_id, source])
  @@index([company, grade])
}

model CardEbaySoldGradedPriceSnapshot {
  id           String   @id @default(cuid())
  card_id      String
  source       String   @default("ebay_sold")
  label        String
  company      String
  grade        String
  median_price Float
  currency     String   @default("USD")
  sample_size  Int?
  fetched_at   DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([card_id, source, label, fetched_at])
  @@index([fetched_at])
}

model CardEbayDemandListing {
  id                  String    @id @default(cuid())
  card_id             String
  marketplace_id      String
  mode                String
  item_id             String
  title               String
  image_url           String?
  item_web_url        String
  listing_type        String
  buying_options_json String
  price_eur           Float?
  shipping_eur        Float?
  total_eur           Float?
  currency            String
  condition           String?
  seller_username     String?
  item_creation_date  DateTime?
  item_end_date       DateTime?
  first_seen_at       DateTime  @default(now())
  last_seen_at        DateTime  @default(now())
  missed_scan_count   Int       @default(0)
  last_missed_on      DateTime?
  removed_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([card_id, marketplace_id, mode, item_id])
  @@index([card_id, marketplace_id, mode, removed_at])
  @@index([card_id, marketplace_id, mode, last_seen_at])
  @@index([item_id, marketplace_id])
  @@index([removed_at])
}

model CardEbayDemandSnapshot {
  id              String   @id @default(cuid())
  card_id         String
  marketplace_id  String
  mode            String
  snapshot_date   DateTime
  observed_count  Int
  clean_count     Int
  capped          Boolean  @default(false)
  active_count    Int
  new_count       Int
  removed_count   Int
  median_ask_eur  Float?
  lowest_ask_eur  Float?
  highest_ask_eur Float?
  auction_count   Int      @default(0)
  fixed_count     Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([card_id, marketplace_id, mode, snapshot_date])
  @@index([card_id, marketplace_id, mode, snapshot_date])
  @@index([snapshot_date])
}

model EbayListingCardOverride {
  id             String   @id @default(cuid())
  user_id        String
  marketplace_id String
  item_id        String
  card_id        String?
  status         String
  title_snapshot String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card Card? @relation(fields: [card_id], references: [id], onDelete: SetNull)

  @@unique([user_id, marketplace_id, item_id])
  @@index([card_id])
  @@index([user_id, status])
}

model EbayWatchedListing {
  id                String    @id @default(cuid())
  user_id           String
  marketplace_id    String
  item_id           String
  title             String
  item_web_url      String
  image_url         String?
  card_id           String?
  sealed_product_id String?
  mode              String    @default("raw")
  price_eur         Float?
  reference_eur     Float?
  discount_percent  Float?
  seller_username   String?
  item_end_date     DateTime?
  created_at        DateTime  @default(now())

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card Card? @relation(fields: [card_id], references: [id], onDelete: SetNull)

  @@unique([user_id, marketplace_id, item_id])
  @@index([user_id, created_at])
  @@index([card_id])
}

model CardPriceAlert {
  id                  String    @id @default(cuid())
  user_id             String
  card_id             String
  kind                String
  target_price_eur    Float?
  baseline_price_eur  Float?
  baseline_price_at   DateTime?
  enabled             Boolean   @default(true)
  triggered_at        DateTime?
  triggered_price_eur Float?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([user_id, card_id])
  @@index([enabled, updated_at])
  @@index([card_id, enabled])
}

model CollectionPriceAlert {
  id                  String    @id @default(cuid())
  user_id             String
  target_type         String
  target_id           String
  kind                String
  target_price_eur    Float?
  baseline_price_eur  Float?
  baseline_price_at   DateTime?
  enabled             Boolean   @default(true)
  triggered_at        DateTime?
  triggered_price_eur Float?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, target_type, target_id])
  @@index([enabled, updated_at])
  @@index([target_type, target_id, enabled])
}

model CollectionBinder {
  id                  String   @id @default(cuid())
  user_id             String?
  name                String
  type                String
  episode_id          String?
  accent_color        String?
  icon_name           String?
  notes               String?
  base_purchase_price Float?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user    User?            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  episode Episode?         @relation(fields: [episode_id], references: [id])
  cards   CollectionCard[]
  shareLinks BinderShareLink[]

  @@index([user_id])
  @@index([type])
  @@index([episode_id])
  @@index([created_at])
}

model BinderShareLink {
  id         String    @id @default(cuid())
  user_id    String
  binder_id  String
  token      String    @unique
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user   User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  binder CollectionBinder @relation(fields: [binder_id], references: [id], onDelete: Cascade)

  @@unique([user_id, binder_id])
  @@index([binder_id, revoked_at])
  @@index([revoked_at, updated_at])
}

model CollectionCard {
  id                       String    @id @default(cuid())
  user_id                  String?
  card_id                  String
  binder_id                String?
  purchase_price           Float?
  condition                String?
  language                 String?
  notes                    String?
  grading_company          String?
  grading_grade            String?
  grading_subgrades_json   String?
  origin_sealed_product_id String?
  purchase_price_source    String?
  for_sale                 Boolean   @default(false)
  sale_price               Float?
  sold_at                  DateTime?
  added_at                 DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  user                User?               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card                Card                @relation(fields: [card_id], references: [id])
  binder              CollectionBinder?   @relation(fields: [binder_id], references: [id], onDelete: SetNull)
  originSealedProduct SealedProduct?      @relation("CollectionCardOriginSealedProduct", fields: [origin_sealed_product_id], references: [id], onDelete: SetNull)
  tags                CollectionCardTag[]

  @@index([user_id])
  @@index([card_id])
  @@index([card_id, added_at])
  @@index([binder_id])
  @@index([binder_id, added_at])
  @@index([origin_sealed_product_id])
  @@index([user_id, for_sale])
  @@index([user_id, for_sale, sold_at])
  @@index([sold_at])
  @@index([added_at])
}

model CollectionCardTag {
  id                 String @id @default(cuid())
  collection_card_id String
  label              String

  collection_card CollectionCard @relation(fields: [collection_card_id], references: [id], onDelete: Cascade)

  @@index([collection_card_id])
  @@index([label])
}

model CollectionWant {
  id                String    @id @default(cuid())
  user_id           String
  card_id           String
  notes             String?
  source            String    @default("manual")
  source_episode_id String?
  dismissed_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([user_id, card_id])
  @@index([user_id])
  @@index([card_id])
  @@index([source])
  @@index([source_episode_id])
  @@index([dismissed_at])
  @@index([created_at])
}

model CollectionSealed {
  id                      String   @id @default(cuid())
  user_id                 String?
  product_id              String
  quantity                Int      @default(1)
  purchase_price_per_item Float?
  notes                   String?
  added_at                DateTime @default(now())
  updated_at              DateTime @updatedAt

  user    User?                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product SealedProduct         @relation(fields: [product_id], references: [id])
  tags    CollectionSealedTag[]

  @@index([user_id])
  @@index([product_id])
  @@index([product_id, added_at])
  @@index([added_at])
}

model CollectionSealedTag {
  id                   String @id @default(cuid())
  collection_sealed_id String
  label                String

  collection_sealed CollectionSealed @relation(fields: [collection_sealed_id], references: [id], onDelete: Cascade)

  @@index([collection_sealed_id])
  @@index([label])
}

model Price {
  id         String    @id @default(cuid())
  card_id    String
  fetched_at DateTime  @default(now())
  // When the marketplace value last changed. Unlike fetched_at this does not
  // move forward for an unchanged refresh observation.
  changed_at DateTime?

  // Provenance for the English NM quote. Older rows remain null and are
  // treated as legacy TCGGo snapshots.
  source          String?
  source_provider String?
  source_url      String?

  // CardMarket prices per language
  cm_en_lowest_nm Float?
  cm_de_lowest_nm Float?
  cm_fr_lowest_nm Float?
  cm_es_lowest_nm Float?
  cm_it_lowest_nm Float?
  cm_jp_lowest_nm Float?
  cm_en_avg_30d   Float?
  cm_en_avg_7d    Float?

  // TCGPlayer prices
  tcp_market Float?
  tcp_mid    Float?
  tcp_low    Float?

  card Card @relation(fields: [card_id], references: [id])

  @@index([card_id])
  @@index([card_id, fetched_at])
  @@index([card_id, fetched_at, id])
  @@index([fetched_at])
  @@index([source, fetched_at])
}

model NewReleaseChasePriceWatch {
  card_id                 String    @id
  episode_id              String
  candidate_rank          Int
  status                  String    @default("scheduled")
  first_seen_at           DateTime  @default(now())
  last_attempt_at         DateTime?
  last_success_at         DateTime?
  next_attempt_at         DateTime?
  consecutive_failures    Int       @default(0)
  provider                String?
  last_error              String?
  candidate_price         Float?
  candidate_observed_at   DateTime?
  candidate_confirmations Int       @default(0)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([episode_id, candidate_rank])
  @@index([status, next_attempt_at])
  @@index([next_attempt_at])
}

model ScrapeDoCreditLedger {
  id                String    @id @default(cuid())
  period_key        String
  day_key           String
  consumer          String
  operation         String
  idempotency_key   String    @unique
  status            String    @default("reserved")
  estimated_credits Int
  credits_used      Int       @default(0)
  remaining_credits Int?
  source_url        String?
  details_json      String?
  reserved_at       DateTime  @default(now())
  expires_at        DateTime
  finished_at       DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([period_key, status])
  @@index([day_key, status])
  @@index([consumer, period_key, status])
  @@index([consumer, day_key, status])
  @@index([status, expires_at])
}

model SyncLog {
  id                  String    @id @default(cuid())
  type                String
  status              String
  message             String?
  details_json        String?
  started_at          DateTime  @default(now())
  finished_at         DateTime?
  cancel_requested_at DateTime?

  @@index([status, started_at])
  @@index([type, status, started_at])
  @@index([type, status, finished_at])
  @@index([cancel_requested_at])
}

model SyncJob {
  id           String    @id @default(cuid())
  type         String    @unique
  status       String
  details_json String?
  started_at   DateTime?
  finished_at  DateTime?
  heartbeat_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([status, updated_at])
  @@index([type, status])
}

model FirecrawlCreditLedger {
  id                String    @id @default(cuid())
  period_key        String
  consumer          String
  operation         String
  idempotency_key   String    @unique
  status            String    @default("reserved")
  estimated_credits Int
  credits_used      Int       @default(0)
  source_url        String?
  details_json      String?
  reserved_at       DateTime  @default(now())
  expires_at        DateTime
  finished_at       DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([period_key, status])
  @@index([consumer, period_key, status])
  @@index([status, expires_at])
}

// A run is the durable boundary for either a competitive scan or a daily
// catalyst discovery pass. Keeping every successful scan makes future 30/90/
// 180-day forecast calibration possible instead of inventing probabilities.
model ExternalSignalRun {
  id           String    @id @default(cuid())
  kind         String
  status       String
  requested_at DateTime  @default(now())
  generated_at DateTime?
  finished_at  DateTime?
  source_count Int       @default(0)
  item_count   Int       @default(0)
  credits_used Int       @default(0)
  details_json String?
  error        String?
  created_at   DateTime  @default(now())

  observations ExternalSignalObservation[]

  @@unique([kind, generated_at])
  @@index([kind, status, requested_at])
  @@index([kind, finished_at])
}

model ExternalSignalObservation {
  id                            String    @id @default(cuid())
  run_id                        String
  card_id                       String
  game                          String
  card_name                     String
  episode_code                  String?
  card_number                   String?
  model_version                 String    @default("v1")
  price_band                    String?
  reference_source              String?
  reference_price               Float?
  reference_price_at            DateTime?
  is_episode_entry              Boolean   @default(false)
  entry_outlook                 String?
  entry_expected_return_pct_180 Float?
  entry_opportunity_score       Float?
  entry_scenario_json           String?
  external_score                Float
  competitive_score             Float     @default(0)
  confidence                    String
  pressure_label                String
  current_price                 Float?
  currency                      String
  max_deck_share_percent        Float
  max_inclusion_percent         Float
  archetype_count               Int
  catalyst_score                Float     @default(0)
  hype_score                    Float     @default(0)
  risk_score                    Float     @default(0)
  hit_rate_15x_90               Float?
  hit_rate_2x_90                Float?
  hit_rate_3x_180               Float?
  sample_size_90                Int?
  sample_size_180               Int?
  reasons_json                  String
  evidence_json                 String
  observed_at                   DateTime  @default(now())

  run      ExternalSignalRun       @relation(fields: [run_id], references: [id], onDelete: Cascade)
  outcomes ExternalSignalOutcome[]

  @@unique([run_id, card_id])
  @@index([card_id, observed_at])
  @@index([game, external_score])
  @@index([observed_at])
}

model ExternalSignalOutcome {
  id                   String    @id @default(cuid())
  entry_observation_id String
  horizon_days         Int
  status               String    @default("pending")
  evaluated_at         DateTime?
  observed_days        Int       @default(0)
  coverage_ratio       Float     @default(0)
  max_reference_price  Float?
  max_multiplier       Float?
  end_reference_price  Float?
  hit_15x              Boolean?
  hit_2x               Boolean?
  hit_3x               Boolean?
  realized_return_pct  Float?
  direction_hit        Boolean?
  band_within          Boolean?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  entry_observation ExternalSignalObservation @relation(fields: [entry_observation_id], references: [id], onDelete: Cascade)

  @@unique([entry_observation_id, horizon_days])
  @@index([horizon_days, status, evaluated_at])
  @@index([entry_observation_id])
}

// Search results are canonicalized before insert. A source can therefore be
// discovered every day for free without being scraped twice.
model ExternalCatalystSource {
  id              String    @id @default(cuid())
  canonical_url   String    @unique
  url_hash        String    @unique
  domain          String
  game            String
  source_type     String
  title           String?
  description     String?
  published_at    DateTime?
  first_seen_at   DateTime  @default(now())
  last_seen_at    DateTime  @default(now())
  last_scraped_at DateTime?
  scrape_status   String    @default("pending")
  content_hash    String?
  content_excerpt String?
  metadata_json   String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  catalysts ExternalCardCatalyst[]

  @@index([game, last_seen_at])
  @@index([source_type, last_seen_at])
  @@index([scrape_status, last_seen_at])
}

model ExternalCardCatalyst {
  id               String    @id @default(cuid())
  source_id        String
  entity_key       String
  card_id          String?
  game             String
  catalyst_type    String
  direction        String
  strength         Float
  headline         String
  explanation      String
  evidence_excerpt String?
  observed_at      DateTime  @default(now())
  expires_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  source ExternalCatalystSource @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([source_id, entity_key, catalyst_type])
  @@index([card_id, observed_at])
  @@index([game, observed_at])
  @@index([catalyst_type, direction, observed_at])
  @@index([expires_at])
}

model ApiQuotaSnapshot {
  source             String    @id
  requests_limit     Int?
  requests_remaining Int?
  requests_used      Int?
  quota_resets_at    DateTime?
  observed_at        DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([quota_resets_at])
}
