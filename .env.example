DATABASE_URL="file:./dustycards.db"
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="DustyCards"
FEEDBACK_NOTIFICATION_EMAIL=""
RAPIDAPI_KEY="your-rapidapi-key-here"
RAPIDAPI_HOST="cardmarket-api-tcg.p.rapidapi.com"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-me-please"
# Required only while running `npm run auth:codex-test`; never commit its value.
# DUSTYCARDS_CODEX_TEST_PASSWORD=""
EBAY_ENVIRONMENT="production"
EBAY_CLIENT_ID="your-ebay-client-id"
EBAY_CLIENT_SECRET="your-ebay-client-secret"
EBAY_MARKETPLACE_ID="EBAY_NL"
EBAY_DELIVERY_COUNTRY="NL"
EBAY_CATEGORY_ID="183454"

# Local safety: sync/API scraper requests are blocked in development by default.
# Set this to "1" only when you explicitly want local sync to consume API requests.
DUSTYCARDS_ENABLE_LOCAL_SYNC="0"

# Optional legacy/global kill switch. When "1", scraper/API sync requests are blocked everywhere.
DUSTYCARDS_DISABLE_SCRAPER_REQUESTS="0"

# Optional browser-triggered auto refresh. Leave off; production should use the server scheduler.
DUSTYCARDS_ENABLE_BROWSER_AUTO_PRICE_REFRESH="0"

# Optional: directory where database backups are stored and created.
# Defaults to ../dustycards-db-backups, ../backups, ./backups, or /opt/dustycards/backups.
# DUSTYCARDS_BACKUP_DIR=""

# Optional persistent image-cache directory. Production keeps this outside the
# source tree so builds never scan tens of thousands of runtime image files.
# DUSTYCARDS_IMAGE_CACHE_DIR="/opt/dustycards/cache/image-cache"

# Optional timing logs for expensive server computations.
# DUSTYCARDS_TIMING="1"

# Deploy target for scripts/deploy-production.ps1 (user@host).
# DUSTYCARDS_DEPLOY_HOST="dustyadmin@your-server-ip"

# Security hardening. Generate unique random values of at least 32 characters.
# AUTH_MFA_ENCRYPTION_KEY="replace-with-a-random-secret"
# SECURITY_EVENT_HASH_KEY="replace-with-a-different-random-secret"
# DUSTYCARDS_REQUIRE_ADMIN_MFA="true"

# Optional encrypted off-site backup mirror. This must point at a separately
# mounted remote/object-storage-backed filesystem, not the server's root disk.
# DUSTYCARDS_OFFSITE_BACKUP_DIR="/mnt/dustycards-offsite"
# DUSTYCARDS_BACKUP_ENCRYPTION_KEY="replace-with-a-third-random-secret"

# Optional admin-only Firecrawl tooling in Settings. Keep this server-side.
FIRECRAWL_API_KEY="your-firecrawl-api-key"
FIRECRAWL_API_KEY_SECOND="your-second-firecrawl-api-key"
# Optional alternative for larger pools: comma- or newline-separated keys.
FIRECRAWL_API_KEYS=""
FIRECRAWL_MONTHLY_CREDIT_BUDGET="1000"
# Hard sub-budget for the daily, deduplicated external signal catalyst/news scan.
FIRECRAWL_SIGNAL_MONTHLY_CREDIT_BUDGET="120"
# Optional: manually count credits already spent outside the live database this month.
FIRECRAWL_MONTHLY_CREDIT_OFFSET="0"

# Optional Signal Radar search provider. With this configured, Tavily discovers
# fresh trusted URLs while Firecrawl is reserved for full article extraction.
TAVILY_API_KEY="your-tavily-api-key"

# Optional secondary scrape/search provider. Keep this server-side only.
# Plain URL scraping normally costs 1 credit; rendered pages cost more.
SCRAPEDO_API_KEY="your-scrapedo-api-key"
SCRAPEDO_MONTHLY_CREDIT_BUDGET="1000"
# Dedicated hard caps for direct English/NM New Chase Watch checks. CardMarket
# uses Scrape.do's five-credit rendered browser profile; these caps do not
# increase the provider plan and keep a reserve for manual/admin lookups.
SCRAPEDO_CHASE_MONTHLY_CREDIT_BUDGET="650"
SCRAPEDO_CHASE_DAILY_CREDIT_BUDGET="40"
SCRAPEDO_PROVIDER_RESERVE_CREDITS="50"
# SCRAPEDO_API_URL="https://api.scrape.do"
# SCRAPEDO_TIMEOUT_MS="60000"
